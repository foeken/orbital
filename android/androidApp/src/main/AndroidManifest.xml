<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- dictation in Quick Add and the composer, asked for the first time it is used -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- nothing of this phone's leaves it in a backup: Tana's cookies, the ChatGPT tokens (Keystore-sealed), the settings mirror -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Orbital"
        android:supportsRtl="true"
        android:theme="@style/Orbital">
        <!-- a turn, a fold, a window resized or a keyboard is laid out by Compose in place, not a new screen: the web
             view holding Tana's page stays in its window and what is open and typed stays. Dark mode (uiMode) still
             makes the screen again, so the window's own theme (values-night) and the system bars follow it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- orbital:<id> (orbital:tana:text:…) from anywhere opens that node, as on the iPhone and the Mac -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbital" />
            </intent-filter>
            <!-- the launcher's shortcuts and Assistant's create a task (Siri and Shortcuts on the iPhone) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Orbital's own way in: its widgets, its Quick Settings tile and its launcher shortcuts open this screen, which no
             other app may start; it hands their link to MainActivity in the app's own memory, so only theirs write at once
             (MainActivity.kt FromOrbital; docs/ANDROID.md Security). No screen of its own. -->
        <activity
            android:name=".FromOrbital"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- shared to Orbital: words or an image, opened in Quick Add (the iPhone's Share extension). It runs in the
             sharing app's task with no screen of its own (no task of ours to join: taskAffinity ""), leaves what was
             shared and brings Orbital forward in its own task. -->
        <activity
            android:name=".ShareActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Orbital"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Orbital">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- the widgets (Widgets.kt): Today's Tasks, and the Timeline as Today's Tasks and Upcoming Meetings and as
             Activity, each on the home screen, the lock screen and a Galaxy Z Flip's cover screen (flex_window) -->
        <receiver
            android:name=".TodayWidgetReceiver"
            android:exported="false"
            android:label="Today's Tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/flex_window" />
        </receiver>
        <receiver
            android:name=".AheadWidgetReceiver"
            android:exported="false"
            android:label="Today's Tasks and Upcoming Meetings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ahead_widget" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/flex_window" />
        </receiver>
        <receiver
            android:name=".ActivityWidgetReceiver"
            android:exported="false"
            android:label="Activity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/activity_widget" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/flex_window" />
        </receiver>
        <!-- Quick Add in Quick Settings, on the lock screen too (the iPhone's Lock Screen Quick Add): only the system binds it -->
        <service
            android:name=".QuickAddTile"
            android:exported="true"
            android:icon="@drawable/add"
            android:label="@string/shortcut_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
