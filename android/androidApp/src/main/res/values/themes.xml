<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the page's own colour from the first frame, so a cold start never flashes another (Theme.kt Colors.page) -->
    <style name="Orbital" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
